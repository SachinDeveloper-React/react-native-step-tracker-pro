# OS
.DS_Store

# Dependencies
node_modules/

# Build output. `lib/` is generated by `bob build`, which npm runs from the
# `prepack` script on publish, so it never needs to be committed.
lib/
android/build/
android/.gradle/
example/android/build/
example/android/.gradle/

# Machine-specific: points at whoever's Android SDK built last.
android/local.properties

# Kept on purpose:
#   android/gradle/wrapper/  — pins the Gradle every contributor builds with
#   android/schemas/         — Room schema history, needed to write migrations
#   package-lock.json        — reproducible installs

# Logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.metro-health-check*
.eslintcache

# Editors
*.iml
.idea/
.cxx/
*.hprof
