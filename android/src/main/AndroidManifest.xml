<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Step sensors. Runtime permission from API 29. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission
        android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION"
        android:maxSdkVersion="28" />

    <!-- Foreground service. FOREGROUND_SERVICE_HEALTH is required from API 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Used by WorkManager to hold the CPU awake while a sync job runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Only needed if you call requestDisableBatteryOptimization(). Remove this
      line and use openBatteryOptimizationSettings() instead if you do not have
      an eligible Play Console use case. See docs/PLAY_STORE_COMPLIANCE.md.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="merge" />

    <!-- Health Connect. Remove the pairs you do not use. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" />

    <!--
      Optional Health Connect grants, only requested when the matching config
      flag is on (healthConnectBackgroundRead / healthConnectHistoryRead).
      Declaring one you never request is harmless; requesting one you have not
      declared is silently dropped by the provider.

      READ_HEALTH_DATA_IN_BACKGROUND lets a WorkManager sync read a watch's
      steps while the app is closed. Without it every background read returns
      empty, so a wearable-sourced widget goes stale until the user opens
      the app.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Reads older than 30 days. Needed for yearly stats off Health Connect. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.stepdetector"
        android:required="false" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Resolving the Play Store deep link that installs Health Connect. -->
        <package android:name="com.android.vending" />
        <!--
          Companion apps surfaced by getInstalledCompanionApps(), so onboarding
          can name the watch app the user already has instead of asking blind.
          Package visibility is opt-in from Android 11, and an unlisted package
          reads as not installed rather than failing loudly.
        -->
        <package android:name="com.google.android.wearable.app" />
        <package android:name="com.google.android.apps.wearable.health" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.samsung.android.app.watchmanager" />
        <package android:name="com.samsung.android.wear.shealth" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.huawei.health" />
        <package android:name="com.hihonor.health" />
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.zepp.life" />
        <package android:name="com.huami.midong" />
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.heytap.health" />
        <package android:name="com.oneplus.health.international" />
        <package android:name="com.ouraring.oura" />
        <package android:name="com.whoop.android" />
        <package android:name="fi.polar.polarflow" />
        <package android:name="com.stt.android.suunto" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="com.yf.smart.coros.dist" />
        <!--
          OEM battery / autostart managers, so openManufacturerAutoStartSettings()
          can resolve their screens. Without these every deep link reads as
          "not installed" on Android 11+ and the call falls back to the plain
          app-info page, which is not where the autostart toggle lives.
        -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.abe" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.transsion.phonemanager" />
        <package android:name="com.transsion.phonemaster" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.evenwell.powersaving.g3" />
        <package android:name="com.letv.android.letvsafe" />
        <package android:name="com.lenovo.security" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application>
        <service
            android:name="com.steptrackerpro.service.StepTrackerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health"
            android:stopWithTask="false" />

        <receiver
            android:name="com.steptrackerpro.service.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.steptrackerpro.service.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name="com.steptrackerpro.health.HealthPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/StepTrackerPro.Transparent" />

        <!--
          Health Connect requires every app that requests health permissions to
          answer "why do you want this?" with an activity, and Play review
          rejects health apps that do not have one. It opens the
          `privacyPolicyUrl` from config.

          The two filters are not alternatives to pick between - a single APK
          needs both. Android 14 folded Health Connect into the platform and
          routes through the standard VIEW_PERMISSION_USAGE action, while
          Android 13 and below go through the provider APK's own
          androidx.health action.

          To show your own screen instead, point these at your activity in the
          app manifest with tools:node="replace"; see docs/INSTALLATION.md.
        -->
        <activity
            android:name="com.steptrackerpro.health.HealthPrivacyPolicyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/StepTrackerPro.Transparent">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.steptrackerpro.health.ViewPermissionUsageActivity"
            android:targetActivity="com.steptrackerpro.health.HealthPrivacyPolicyActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
