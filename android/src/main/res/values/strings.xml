<resources>
    <string name="stp_channel_name">Step tracking</string>
    <string name="stp_channel_description">Keeps counting your steps while the app is closed.</string>
    <!-- The notification's title when notificationTitle is not set. %s is the count, already formatted. -->
    <plurals name="stp_notification_title">
        <item quantity="one">%s step</item>
        <item quantity="other">%s steps</item>
    </plurals>
    <!-- The line under the title. %s is the daily goal, already formatted. -->
    <string name="stp_notification_goal">%s goal</string>
    <string name="stp_notification_text">%1$s km · %2$s kcal · %3$d%% of goal</string>
    <!-- The same line when notificationDistanceUnit shows miles. -->
    <string name="stp_notification_text_miles">%1$s mi · %2$s kcal · %3$d%% of goal</string>
    <!-- What {unit} in notificationTitle and notificationText becomes. -->
    <string name="stp_unit_km">km</string>
    <string name="stp_unit_mi">mi</string>
    <string name="stp_action_open">Open</string>
    <string name="stp_action_pause">Pause</string>
    <string name="stp_action_resume">Resume</string>
    <string name="stp_paused_text">Tracking paused</string>
    <!-- What a locked screen shows in place of the count, under notificationLockScreen: 'private'. -->
    <string name="stp_locked_text">Counting steps</string>
    <string name="stp_privacy_policy_missing">No privacy policy URL is configured for this app.</string>
</resources>
