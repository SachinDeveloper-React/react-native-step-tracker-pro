{
  "name": "react-native-step-tracker-pro",
  "version": "1.3.0",
  "description": "Production-grade Android step tracking for React Native: hardware step counter, foreground service, Room storage, Health Connect permissions and sync, wearable step sources, boot recovery and goals.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SachinDeveloper-React/react-native-step-tracker-pro.git"
  },
  "homepage": "https://github.com/SachinDeveloper-React/react-native-step-tracker-pro#readme",
  "bugs": {
    "url": "https://github.com/SachinDeveloper-React/react-native-step-tracker-pro/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/gradle",
    "!android/gradlew*",
    "!android/local.properties",
    "!android/settings.gradle",
    "!android/schemas",
    "!android/src/androidTest",
    "!android/src/test",
    "!**/__tests__",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "clean": "rimraf lib android/build",
    "prepack": "bob build"
  },
  "keywords": [
    "react-native",
    "android",
    "pedometer",
    "step-counter",
    "steps",
    "fitness",
    "health-connect",
    "wear-os",
    "smartwatch",
    "foreground-service",
    "turbo-module"
  ],
  "license": "MIT",
  "author": "Helper <sachinkumarq87@gmail.com>",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.77.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-builder-bob": "^0.30.0",
    "typescript": "^5.4.0"
  },
  "codegenConfig": {
    "name": "RNStepTrackerProSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.steptrackerpro"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
