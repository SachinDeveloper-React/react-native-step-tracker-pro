{
  "name": "react-native-step-tracker-pro",
  "version": "1.5.0",
  "description": "Production-grade Android step tracking for React Native: hardware step counter, foreground service, Room storage, Health Connect permissions and sync, wearable step sources, boot recovery and goals.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SachinDeveloper-React/react-native-step-tracker-pro.git"
  },
  "homepage": "https://github.com/SachinDeveloper-React/react-native-step-tracker-pro#readme",
  "bugs": {
    "url": "https://github.com/SachinDeveloper-React/react-native-step-tracker-pro/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/.kotlin",
    "!android/gradle",
    "!android/gradlew*",
    "!android/local.properties",
    "!android/settings.gradle",
    "!android/schemas",
    "!android/src/androidTest",
    "!android/src/test",
    "!**/__tests__",
    "!**/__mocks__",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src example --max-warnings 0",
    "format": "prettier --check \"{src,example}/**/*.{ts,tsx}\" \"*.{js,json}\"",
    "format:write": "prettier --write \"{src,example}/**/*.{ts,tsx}\" \"*.{js,json}\"",
    "test": "jest",
    "test:android": "cd android && ./gradlew testDebugUnitTest",
    "test:android:device": "cd android && ./gradlew connectedDebugAndroidTest",
    "lint:android": "cd android && ./gradlew lintDebug",
    "build": "bob build",
    "clean": "rimraf lib android/build",
    "prepack": "bob build"
  },
  "keywords": [
    "react-native",
    "android",
    "pedometer",
    "step-counter",
    "steps",
    "fitness",
    "health-connect",
    "wear-os",
    "smartwatch",
    "foreground-service",
    "turbo-module"
  ],
  "license": "MIT",
  "author": "Helper <sachinkumarq87@gmail.com>",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.77.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "18.3.1",
    "react-native": "0.77.0",
    "react-native-builder-bob": "^0.30.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.0"
  },
  "codegenConfig": {
    "name": "RNStepTrackerProSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.steptrackerpro"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
